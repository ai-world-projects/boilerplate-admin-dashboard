# --- API mocking (MSW) -------------------------------------------------------
# "enabled"  → the app runs entirely on the in-browser MSW mocks (the Vercel
#              demo uses this; no backend required).
# "disabled" → MSW is off; the app calls the real backend at
#              NEXT_PUBLIC_API_BASE_URL.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so set this in the Vercel
# project's Environment Variables before building — a runtime change won't apply.
NEXT_PUBLIC_API_MOCKING=enabled          # demo on mocks

# --- Real backend (when NEXT_PUBLIC_API_MOCKING=disabled) --------------------
# Point the axios client at your API. No component/service code changes needed.
# NEXT_PUBLIC_API_MOCKING=disabled       # real backend
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
